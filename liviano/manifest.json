{
  "manifest_version": 3,
  "name": "Liviano",
  "version": "1.3.0",
  "description": "Navegador más liviano: bloquea anuncios y rastreadores, suspende pestañas inactivas y ofrece tres modos: Eco, Pro y Extremo.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Liviano",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "search",
    "topSites",
    "favicon",
    "privacy",
    "contextMenus",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "trackers", "enabled": true, "path": "rules/trackers.json" },
      { "id": "extreme", "enabled": false, "path": "rules/extreme.json" },
      { "id": "images", "enabled": false, "path": "rules/images.json" }
    ]
  }
}
